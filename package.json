{
  "name": "opencode-ms-teams",
  "version": "1.3.1",
  "description": "OpenCode ↔ Microsoft Teams 양방향 플러그인. 세션 idle 시 응답을 Teams 채팅으로 전송하고 답신을 세션에 재주입.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "microsoft-teams",
    "msteams",
    "microsoft-graph",
    "chatops",
    "remote-control",
    "notification"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencode-ms-teams": "bin/cli.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "scripts/install-lib.mjs",
    "postinstall.mjs",
    "opencode.json.example",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y00njinuk/opencode-ms-teams.git"
  },
  "homepage": "https://github.com/y00njinuk/opencode-ms-teams#readme",
  "bugs": {
    "url": "https://github.com/y00njinuk/opencode-ms-teams/issues"
  },
  "author": "Jin Uk Yoon",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "opencode": ">=1.4.17"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.17"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.4.17",
    "@opencode-ai/sdk": "1.4.17",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "prepack": "npm run clean && npm run build",
    "postinstall": "node postinstall.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:linux": "bash scripts/test-linux.sh",
    "test:ubuntu": "bash scripts/test-linux.sh ubuntu",
    "test:rocky": "bash scripts/test-linux.sh rocky",
    "release": "bash scripts/release.sh",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major"
  }
}
